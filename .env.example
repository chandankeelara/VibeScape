# ==============================================================================
# VibeScape environment configuration
# ==============================================================================
# Copy to `.env` and fill in real values for local dev.
# In production (Fly/Cloud Run/HF Spaces), set these via the platform's
# secrets/env-vars UI instead of committing a .env file.
#
# Anything commented out uses the default shown; uncomment to override.
# ==============================================================================


# ------------------------------------------------------------------------------
# ML mode
# ------------------------------------------------------------------------------
# The offline pipeline's classify stage always runs MERT in-process: it needs
# torch, the checkpoint at ml/models/mert_v1.ckpt (or VIBESCAPE_MERT_CKPT) and,
# in practice, a CUDA GPU. VIBESCAPE_ML_MODE does not route it anywhere
# (ingest/ml_backend.py predict_and_embed_from_path loads the local checkpoint
# in every mode), and Modal could not serve it: modal_app.py's
# predict_from_url returns no embedding. The mode only decides whether
# classify warns at startup that no ML backend is available.
#
#   local            in-process MERT. Set this on the pipeline machine.
#   auto   (default) modal if MODAL_TOKEN_ID is set, else local, else none.
#   modal            the modal_app.py deployment; the pipeline never calls it.
#   none             no ML backend.
#
VIBESCAPE_ML_MODE=auto


# ------------------------------------------------------------------------------
# Spotify OAuth (required)
# ------------------------------------------------------------------------------
# Get these from https://developer.spotify.com/dashboard.
# SPOTIFY_REDIRECT_URI must exactly match one of the redirect URIs registered
# on your Spotify app — including trailing slash and scheme.
#
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback


# ------------------------------------------------------------------------------
# Modal (modal_app.py only; nothing in the ingest pipeline calls it, see above)
# ------------------------------------------------------------------------------
# Deploy the ML app once with `modal deploy modal_app.py`, then paste the
# tokens from `modal token new` here (or set them as platform secrets).
#
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Modal app + function names — only override if you renamed anything in
# modal_app.py before deploying.
#MODAL_APP_NAME=vibescape-ml
#MODAL_FUNCTION_NAME=predict_from_url
#MODAL_LANG_FUNCTION_NAME=predict_language_from_url


# ------------------------------------------------------------------------------
# Local ML knobs (classify reads the checkpoint and device ones in every mode)
# ------------------------------------------------------------------------------
# Path to the trained MERT checkpoint. Defaults to <repo>/ml/models/mert_v1.ckpt.
#VIBESCAPE_MERT_CKPT=ml/models/mert_v1.ckpt

# Whisper model size for language detection: tiny | base | small | medium | large-v3.
# Smaller = faster + less accurate. `small` is the default and a good balance.
#VIBESCAPE_WHISPER_MODEL=small

# Torch device override. Leave unset to auto-pick (cuda if available, else cpu).
#VIBESCAPE_TORCH_DEVICE=cuda


# ------------------------------------------------------------------------------
# Deployment mode
# ------------------------------------------------------------------------------
# VIBESCAPE_ENV controls whether the browser sees verbose debug logs.
#
#   prod (default) Quiet. Only warnings/errors get logged.
#   dev            Verbose. Every SDK state change, end-of-track detection,
#                  and advanceToNext decision is logged with a [VS] prefix.
#                  Set this in your local .env, NOT in production secrets.
#
# The value is served via GET /api/client-config on boot; app.js reads it
# and sets a runtime flag.
#
#VIBESCAPE_ENV=prod


# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
# Port the FastAPI server binds to. `PORT` is set by Fly/Cloud Run/HF Spaces
# automatically; VIBESCAPE_PORT is an override for local dev.
#VIBESCAPE_PORT=8000
#PORT=8000

# Which user_id is treated as admin (can access override endpoints, see all
# users, etc.). Defaults to the first-seeded user.
#ADMIN_USER_ID=1


# ------------------------------------------------------------------------------
# Ingest CLI helper (only used by `python ingest/ingest.py --match-spotify`)
# ------------------------------------------------------------------------------
# Optional pre-fetched Spotify access token. Skip and the CLI will use the
# client-credentials flow with SPOTIFY_CLIENT_ID / _SECRET above.
#SPOTIFY_TOKEN=


# ------------------------------------------------------------------------------
# Database backend
# ------------------------------------------------------------------------------
# DB_BACKEND selects where the app persists its data.
#
#   sqlite (default) Local file at data/vibescape.db. No extra deps.
#   turso            Remote libSQL/Turso instance, over its HTTP API with
#                    `requests` (backend/db_client.py; it deliberately does
#                    not use libsql-client).
#
DB_BACKEND=sqlite

# Turso connection details — only needed when DB_BACKEND=turso.
# Create a database at https://turso.tech, then grab the URL + auth token
# from the dashboard or `turso db show <name>` / `turso db tokens create`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=


# ------------------------------------------------------------------------------
# Production, for the offline pipeline: a separate .env.prod, NOT this file
# ------------------------------------------------------------------------------
# scripts/run_ingest_v2.py and scripts/language_tags.py take --target
# local|prod. `local` (the default) is the SQLite file whatever DB_BACKEND
# says above. `prod` reads a gitignored .env.prod at the repo root, into that
# one process only (scripts/_target.py). Keep production credentials out of
# .env: uvicorn reads .env, and the dev app must never reach production
# because a pipeline run needed to. .env.prod must set all three:
#
#   DB_BACKEND=turso
#   TURSO_DATABASE_URL=libsql://<database>.turso.io
#   TURSO_AUTH_TOKEN=<read-write token>

.git
.gitignore
.venv
venv
# Production Turso read-write token for `--target prod` (scripts/_target.py).
# No COPY ever takes it into the image; it should not travel as context either.
.env.prod
__pycache__
**/__pycache__
*.pyc
*.pyo

data/audio/
data/*.log
data/*.log.err
data/backup*/
data/recompute_progress.json
data/vibescape.db.presprint
data/vibescape.db.pre-user-tracks-*
# SQLite's WAL sidecars, should a file ever be put in WAL mode by hand
data/*.db-wal
data/*.db-shm
data/yt_cookies*.txt

ml/
scripts/
frontend/node_modules/

*.md
.claude/
.vscode/
.idea/

# frontend-next: only package*.json + src are needed by the build stage.
frontend-next/node_modules/
frontend-next/dist/
